{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "generate:agent-contract": "node scripts/generate-resume-edit-operation-types.mjs --write",
    "generate:template-presets": "node scripts/generate-template-presets.mjs --write",
    "lint": "eslint .",
    "preview": "vite preview",
    "shadcn": "pnpm dlx --package=shadcn@latest --package=zod@3.25.76 shadcn",
    "check:frontend": "pnpm format:check && pnpm test:source-budgets && pnpm lint && pnpm typecheck && pnpm test:behavior && pnpm test:bundle-budgets",
    "test:architecture": "node scripts/run-tests.mjs workspace-architecture workspace-route-boundaries template-boundaries preview-boundaries resume-domain-boundaries",
    "test:behavior": "node scripts/run-tests.mjs",
    "test:bundle-budgets": "node scripts/verify-bundle-budgets.mjs",
    "test:contact-links": "node --test --test-concurrency=4 scripts/verify-contact-links.mjs",
    "test:contract": "node scripts/run-tests.mjs frontend-contract generate-",
    "test:pdf-export": "node --test --test-concurrency=4 scripts/verify-pdf-export-flow.mjs",
    "test:workspace-preferences": "node --test --test-concurrency=4 scripts/verify-workspace-preferences.mjs",
    "test:workspace-load-failure": "node --test --test-concurrency=4 scripts/verify-workspace-load-failure.mjs",
    "test:workspace-routes": "node --test --test-concurrency=4 scripts/verify-workspace-route-data.mjs",
    "test:workspace-architecture": "node --test --test-concurrency=4 scripts/verify-workspace-architecture.mjs",
    "test:workspace-route-boundaries": "node --test --test-concurrency=4 scripts/verify-workspace-route-memory.mjs scripts/verify-workspace-route-boundaries.mjs",
    "test:workspace-route-memory": "node --test --test-concurrency=4 scripts/verify-workspace-route-memory.mjs",
    "test:template-boundaries": "node --test --test-concurrency=4 scripts/verify-template-boundaries.mjs scripts/verify-template-preview-fixtures.mjs",
    "test:shadcn-theme": "node --test --test-concurrency=4 scripts/verify-shadcn-theme.mjs",
    "test:theme-bootstrap": "node --test --test-concurrency=4 scripts/verify-theme-bootstrap.mjs",
    "test:ui-boundaries": "node --test --test-concurrency=4 scripts/verify-ui-module-boundaries.mjs",
    "test:preview-boundaries": "node --test --test-concurrency=4 scripts/verify-preview-boundaries.mjs scripts/verify-document-canvas.mjs scripts/verify-resume-preview-diffs.mjs",
    "test:route-view-panels": "node --test --test-concurrency=4 scripts/verify-route-view-panels.mjs",
    "test:view-transition-cleanup": "node --test --test-concurrency=4 scripts/verify-view-transition-cleanup.mjs",
    "test:model-config": "node --test --test-concurrency=4 scripts/verify-model-config-boundaries.mjs",
    "test:workspace-network": "cd ../backend && RUN_BROWSER_E2E=1 uv run pytest tests/e2e/test_workspace_route_network.py tests/e2e/test_oauth_tab.py tests/e2e/test_oauth_login.py tests/e2e/test_oauth_tab_lifecycle.py tests/e2e/test_oauth_pending_status.py tests/e2e/test_oauth_launch_continuity.py tests/e2e/test_oauth_return_continuity.py -q",
    "test:workspace-network:smoke": "cd ../backend && RUN_BROWSER_E2E=1 uv run --locked pytest tests/e2e/test_workspace_route_network.py tests/e2e/test_workspace_route_motion.py tests/e2e/test_oauth_tab.py tests/e2e/test_oauth_login.py tests/e2e/test_oauth_tab_lifecycle.py tests/e2e/test_oauth_pending_status.py tests/e2e/test_oauth_launch_continuity.py tests/e2e/test_oauth_return_continuity.py tests/e2e/test_auth_session_recovery.py tests/e2e/test_workspace_preferences_react.py tests/e2e/test_resume_detail_transactions.py tests/e2e/test_agent_submission_recovery.py tests/e2e/test_agent_history_quality.py tests/e2e/test_agent_draft_continuation.py tests/e2e/test_agent_draft_editor_conflicts.py tests/e2e/test_agent_model_selector.py tests/e2e/test_model_advanced_settings.py tests/e2e/test_catalog_mutations.py tests/e2e/test_preview_edit_transactions.py tests/e2e/test_pdf_import.py tests/e2e/test_template_save_checkpoints.py tests/e2e/test_resume_inline_formatting.py tests/e2e/test_detail_route_handoffs.py tests/e2e/test_agent_web_network.py tests/e2e/test_i18n_layout.py tests/e2e/test_export_image_boundary.py -m browser_smoke --strict-markers --maxfail=1 --durations=10 -q",
    "test:agent-edits": "node --test --test-concurrency=4 scripts/verify-resume-agent-edits.mjs",
    "test:resume-sections": "node --test --test-concurrency=4 scripts/verify-resume-sections.mjs",
    "test:domain-modules": "node --test --test-concurrency=4 scripts/generate-template-presets.mjs scripts/verify-resume-domain-boundaries.mjs",
    "test:dynamic-import-recovery": "node --test --test-concurrency=4 scripts/verify-dynamic-import-recovery.mjs",
    "test:resume-font-loading": "node --test --test-concurrency=4 scripts/verify-resume-font-loading.mjs",
    "test:agent-panel": "node scripts/run-tests.mjs agent-panel agent-submission agent-diff agent-public agent-render agent-controller",
    "test:agent-controller-boundaries": "node --test --test-concurrency=4 scripts/verify-agent-controller-boundaries.mjs",
    "test:agent-render-boundaries": "node --test --test-concurrency=4 scripts/verify-agent-render-boundaries.mjs",
    "test:agent-sse": "node scripts/run-tests.mjs agent-sse agent-client",
    "test:agent-tools": "node --test --test-concurrency=4 scripts/verify-agent-tool-stream.mjs",
    "test:pdf-import": "node scripts/run-tests.mjs pdf-resume-import pdf-import-lifecycle",
    "test:pdf-export-readiness": "node --test --test-concurrency=4 scripts/verify-pdf-export-readiness.mjs",
    "test:source-budgets": "node scripts/verify-source-budgets.mjs",
    "test": "node scripts/run-tests.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.0.0",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/noto-sans-sc": "^5.3.0",
    "@fontsource-variable/noto-serif-sc": "^5.2.10",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@lobehub/icons": "^5.8.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/math": "^1.0.2",
    "@streamdown/mermaid": "^1.0.2",
    "@tanstack/react-table": "^8.21.3",
    "@tiptap/extension-document": "3.20.4",
    "@tiptap/extension-placeholder": "^3.20.4",
    "@tiptap/extension-subscript": "3.20.4",
    "@tiptap/extension-superscript": "3.20.4",
    "@tiptap/extension-underline": "^3.20.4",
    "@tiptap/pm": "^3.20.4",
    "@tiptap/react": "^3.20.4",
    "@tiptap/starter-kit": "^3.20.4",
    "ai": "^6.0.146",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "diff": "^8.0.3",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^0.577.0",
    "nanoid": "^5.1.7",
    "pdfjs-dist": "^6.0.227",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.1",
    "sonner": "^2.0.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.5.0",
    "use-stick-to-bottom": "^1.1.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "prettier": "3.9.6",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1"
  }
}
