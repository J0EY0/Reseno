{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://resumate.local/schemas/resume-edit-operation.json",
  "title": "ResumeEditOperation",
  "description": "Normalized Resume V2 edit operation exchanged by the backend and frontend.",
  "definitions": {
    "educationItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "school": { "type": "string" },
        "degree": { "type": "string" },
        "major": { "type": "string" },
        "gpa": { "type": "string" },
        "location": { "type": "string" },
        "period": { "type": "string" },
        "description": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "school", "degree", "major", "gpa", "location", "period", "description", "highlights"],
      "additionalProperties": false
    },
    "experienceItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "company": { "type": "string" },
        "position": { "type": "string" },
        "location": { "type": "string" },
        "period": { "type": "string" },
        "description": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "company", "position", "location", "period", "description", "highlights"],
      "additionalProperties": false
    },
    "projectItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "techStack": { "type": "array", "items": { "type": "string" } },
        "period": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "name", "role", "techStack", "period", "url", "description", "highlights"],
      "additionalProperties": false
    },
    "achievementItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "type": "string" },
        "url": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["id", "name", "issuer", "date", "url", "description"],
      "additionalProperties": false
    },
    "simpleListItem": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "content": { "type": "string" }
      },
      "required": ["id", "content"],
      "additionalProperties": false
    },
    "resumeSectionItem": {
      "x-typescript-type": "ResumeSectionItem",
      "oneOf": [
        { "$ref": "#/definitions/educationItem" },
        { "$ref": "#/definitions/experienceItem" },
        { "$ref": "#/definitions/projectItem" },
        { "$ref": "#/definitions/achievementItem" },
        { "$ref": "#/definitions/simpleListItem" }
      ]
    },
    "educationSection": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "education" },
        "title": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/educationItem" } }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "experienceSection": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "experience" },
        "title": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/experienceItem" } }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "projectSection": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "project" },
        "title": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/projectItem" } }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "achievementSection": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "achievement" },
        "title": { "type": "string" },
        "items": { "type": "array", "items": { "$ref": "#/definitions/achievementItem" } }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "simpleListSection": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "const": "simple_list" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/definitions/simpleListItem" }
        }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "resumeSection": {
      "x-typescript-type": "ResumeSection",
      "oneOf": [
        { "$ref": "#/definitions/educationSection" },
        { "$ref": "#/definitions/experienceSection" },
        { "$ref": "#/definitions/projectSection" },
        { "$ref": "#/definitions/achievementSection" },
        { "$ref": "#/definitions/simpleListSection" }
      ]
    },
    "sectionPatch": {
      "type": "object",
      "properties": {
        "title": { "type": "string" }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "itemPatch": {
      "type": "object",
      "properties": {
        "school": { "type": "string" },
        "degree": { "type": "string" },
        "major": { "type": "string" },
        "gpa": { "type": "string" },
        "location": { "type": "string" },
        "period": { "type": "string" },
        "company": { "type": "string" },
        "position": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "techStack": { "type": "array", "items": { "type": "string" } },
        "url": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "type": "string" },
        "description": { "type": "string" },
        "highlights": { "type": "array", "items": { "type": "string" } },
        "content": { "type": "string" }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": { "const": "replace_field" },
        "path": { "type": "string", "enum": ["basic.headline", "basic.location", "basic.summary"] },
        "value": { "type": "string" }
      },
      "required": ["type", "path", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "insert_section" },
        "section": { "$ref": "#/definitions/resumeSection" },
        "index": { "type": "integer" }
      },
      "required": ["type", "section"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "update_section" },
        "sectionId": { "type": "string", "minLength": 1 },
        "patch": { "$ref": "#/definitions/sectionPatch" }
      },
      "required": ["type", "sectionId", "patch"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "delete_section" },
        "sectionId": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "sectionId"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "reorder_sections" },
        "sectionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["type", "sectionIds"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "insert_item" },
        "sectionId": { "type": "string", "minLength": 1 },
        "item": { "$ref": "#/definitions/resumeSectionItem" },
        "index": { "type": "integer" }
      },
      "required": ["type", "sectionId", "item"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "update_item" },
        "sectionId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 },
        "patch": { "$ref": "#/definitions/itemPatch" }
      },
      "required": ["type", "sectionId", "itemId", "patch"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "delete_item" },
        "sectionId": { "type": "string", "minLength": 1 },
        "itemId": { "type": "string", "minLength": 1 }
      },
      "required": ["type", "sectionId", "itemId"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "reorder_items" },
        "sectionId": { "type": "string", "minLength": 1 },
        "itemIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      },
      "required": ["type", "sectionId", "itemIds"],
      "additionalProperties": false
    }
  ]
}
