{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://resumate.local/schemas/resume-edit-operation.json",
  "title": "ResumeEditOperation",
  "description": "Normalized Resume V2 edit operation exchanged by the backend and frontend.",
  "definitions": {
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "resumeSectionItem": {
      "x-typescript-type": "ResumeSectionItem",
      "description": "An item matching the target section kind. Empty string and array fields may be omitted from model input; the backend restores the canonical ResumeDocument shape.",
      "oneOf": [
        { "$ref": "https://resumate.local/schemas/resume-document-v2.json#/definitions/educationItem" },
        { "$ref": "https://resumate.local/schemas/resume-document-v2.json#/definitions/experienceItem" },
        { "$ref": "https://resumate.local/schemas/resume-document-v2.json#/definitions/projectItem" },
        { "$ref": "https://resumate.local/schemas/resume-document-v2.json#/definitions/publicationItem" },
        { "$ref": "https://resumate.local/schemas/resume-document-v2.json#/definitions/achievementItem" },
        { "$ref": "https://resumate.local/schemas/resume-document-v2.json#/definitions/simpleListItem" }
      ]
    },
    "resumeSection": {
      "x-typescript-type": "ResumeSection",
      "description": "A canonical ResumeDocument section. Empty title and items may be omitted from model input.",
      "$ref": "https://resumate.local/schemas/resume-document-v2.json#/definitions/section"
    },
    "sectionPatch": {
      "type": "object",
      "properties": {
        "title": { "type": "string" }
      },
      "required": ["title"],
      "additionalProperties": false
    },
    "itemPatch": {
      "type": "object",
      "description": "Patch only fields belonging to the target section kind. Experience: company is the employer; position is the role or title; location is a geographic place. When no dedicated team field exists, keep a team or product-line fact in description. Project: name is the project or product name; role is the candidate's role only; techStack contains individual technologies only; description states project purpose or scope; highlights contain distinct grounded contributions or capabilities. Publication: title is the work title; authors preserves the cited order and contribution markers; venue is the journal or conference; date is the publication year or date. Move misplaced existing content to the correct fields in the same patch and clear obsolete source fields.",
      "properties": {
        "school": { "type": "string" },
        "degree": { "type": "string" },
        "major": { "type": "string" },
        "gpa": { "type": "string" },
        "location": {
          "type": "string",
          "description": "A geographic place only. If it currently holds a role or title, move that value to the correct field and clear location with an empty string."
        },
        "period": { "type": "string" },
        "company": { "type": "string" },
        "position": { "type": "string" },
        "name": { "type": "string" },
        "title": { "type": "string" },
        "authors": { "type": "string" },
        "venue": { "type": "string" },
        "role": {
          "type": "string",
          "description": "The candidate's role in a project, never a technology list. After moving misplaced technologies to techStack, clear it with an empty string when no grounded role is known."
        },
        "techStack": {
          "type": "array",
          "description": "Individual technologies only. Move non-technology contribution facts found here to highlights, or brief project context to description.",
          "items": { "type": "string" }
        },
        "url": { "type": "string" },
        "issuer": { "type": "string" },
        "date": { "type": "string" },
        "description": {
          "type": "string",
          "description": "Brief context or scope only. Prefer highlights for independent actions, methods, delivered features, capabilities, or outcomes; do not collapse unrelated contributions into this field."
        },
        "highlights": {
          "type": "array",
          "description": "Focused, non-redundant bullets for distinct grounded contributions. Recover contribution facts found in description, role, or techStack, and combine facts only when they describe the same contribution. Use neutral wording when ownership or impact is unknown.",
          "items": { "type": "string" }
        },
        "content": {
          "$ref": "https://resumate.local/schemas/resume-document-v2.json#/definitions/simpleListItem/properties/content"
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  },
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": { "const": "replace_field" },
        "path": { "type": "string", "enum": ["basic.headline", "basic.summary"] },
        "value": { "type": "string" }
      },
      "required": ["type", "path", "value"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "insert_section" },
        "section": { "$ref": "#/definitions/resumeSection" },
        "index": { "type": "integer" }
      },
      "required": ["type", "section"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "update_section" },
        "sectionId": { "$ref": "#/definitions/nodeId" },
        "patch": { "$ref": "#/definitions/sectionPatch" }
      },
      "required": ["type", "sectionId", "patch"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "delete_section" },
        "sectionId": { "$ref": "#/definitions/nodeId" }
      },
      "required": ["type", "sectionId"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "reorder_sections" },
        "sectionIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/nodeId" } }
      },
      "required": ["type", "sectionIds"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "insert_item" },
        "sectionId": { "$ref": "#/definitions/nodeId" },
        "item": { "$ref": "#/definitions/resumeSectionItem" },
        "index": { "type": "integer" }
      },
      "required": ["type", "sectionId", "item"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "update_item" },
        "sectionId": { "$ref": "#/definitions/nodeId" },
        "itemId": { "$ref": "#/definitions/nodeId" },
        "patch": { "$ref": "#/definitions/itemPatch" }
      },
      "required": ["type", "sectionId", "itemId", "patch"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "delete_item" },
        "sectionId": { "$ref": "#/definitions/nodeId" },
        "itemId": { "$ref": "#/definitions/nodeId" }
      },
      "required": ["type", "sectionId", "itemId"],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "type": { "const": "reorder_items" },
        "sectionId": { "$ref": "#/definitions/nodeId" },
        "itemIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/nodeId" } }
      },
      "required": ["type", "sectionId", "itemIds"],
      "additionalProperties": false
    }
  ]
}
