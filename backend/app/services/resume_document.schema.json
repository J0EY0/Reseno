{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://reseno.local/schemas/resume-document-v2.json",
  "title": "ResumeDocumentV2",
  "description": "Content fields, dates, periods and techStack entries accept plain strings or one sanitized <p> with <strong>/<em>/<u>/<sup>/<sub>. Academic italic uses <span data-academic-italic=\"true\">, independently of <em>. Preserve formatting, symbols, author order and contribution or affiliation markers. Keep unformatted values as plain strings; URLs, email and phone stay plain. Preserve existing paragraph/list structure in summary, highlights and content.",
  "type": "object",
  "properties": {
    "schemaVersion": { "const": 2 },
    "basic": { "$ref": "#/definitions/basic" },
    "sections": {
      "type": "array",
      "items": { "$ref": "#/definitions/section" }
    }
  },
  "required": ["schemaVersion", "basic", "sections"],
  "additionalProperties": false,
  "definitions": {
    "nodeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9-]+$"
    },
    "inlineText": {
      "type": "string"
    },
    "customField": {
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": {
          "type": "string",
          "enum": ["email", "phone", "url", "text"]
        },
        "label": { "type": "string" },
        "value": { "type": "string" }
      },
      "required": ["id", "type", "label", "value"],
      "additionalProperties": false
    },
    "basic": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/definitions/inlineText" },
        "headline": { "$ref": "#/definitions/inlineText" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "location": { "$ref": "#/definitions/inlineText" },
        "avatar": { "type": "string" },
        "summary": { "type": "string" },
        "customFields": {
          "type": "array",
          "items": { "$ref": "#/definitions/customField" }
        }
      },
      "required": [
        "name",
        "headline",
        "phone",
        "email",
        "location",
        "avatar",
        "summary",
        "customFields"
      ],
      "additionalProperties": false
    },
    "educationItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "school": { "$ref": "#/definitions/inlineText" },
        "degree": { "$ref": "#/definitions/inlineText" },
        "major": { "$ref": "#/definitions/inlineText" },
        "gpa": { "$ref": "#/definitions/inlineText" },
        "location": { "$ref": "#/definitions/inlineText" },
        "period": { "$ref": "#/definitions/inlineText" },
        "description": { "$ref": "#/definitions/inlineText" },
        "highlights": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "id",
        "school",
        "degree",
        "major",
        "gpa",
        "location",
        "period",
        "description",
        "highlights"
      ],
      "additionalProperties": false
    },
    "experienceItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "company": { "$ref": "#/definitions/inlineText" },
        "position": { "$ref": "#/definitions/inlineText" },
        "location": { "$ref": "#/definitions/inlineText" },
        "period": { "$ref": "#/definitions/inlineText" },
        "description": { "$ref": "#/definitions/inlineText" },
        "highlights": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "id",
        "company",
        "position",
        "location",
        "period",
        "description",
        "highlights"
      ],
      "additionalProperties": false
    },
    "projectItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "name": { "$ref": "#/definitions/inlineText" },
        "role": { "$ref": "#/definitions/inlineText" },
        "techStack": {
          "type": "array",
          "items": { "$ref": "#/definitions/inlineText" }
        },
        "period": { "$ref": "#/definitions/inlineText" },
        "url": { "type": "string" },
        "description": { "$ref": "#/definitions/inlineText" },
        "highlights": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "techStack",
        "period",
        "url",
        "description",
        "highlights"
      ],
      "additionalProperties": false
    },
    "publicationItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "title": { "$ref": "#/definitions/inlineText" },
        "authors": { "$ref": "#/definitions/inlineText" },
        "venue": { "$ref": "#/definitions/inlineText" },
        "date": { "$ref": "#/definitions/inlineText" },
        "url": { "type": "string" },
        "description": { "$ref": "#/definitions/inlineText" }
      },
      "required": [
        "id",
        "title",
        "authors",
        "venue",
        "date",
        "url",
        "description"
      ],
      "additionalProperties": false
    },
    "achievementItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "name": { "$ref": "#/definitions/inlineText" },
        "issuer": { "$ref": "#/definitions/inlineText" },
        "date": { "$ref": "#/definitions/inlineText" },
        "url": { "type": "string" },
        "description": { "$ref": "#/definitions/inlineText" }
      },
      "required": ["id", "name", "issuer", "date", "url", "description"],
      "additionalProperties": false
    },
    "simpleListItem": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "content": {
          "type": "string",
          "description": "Canonical sanitized rich-text HTML for the simple-list section. Tags render structure, not literal text or defects. Preserve HTML when editing; use <ul>/<ol> with <li> for lists and <p> for paragraphs."
        }
      },
      "required": ["id", "content"],
      "additionalProperties": false
    },
    "educationSection": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "kind": { "const": "education" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/educationItem" }
        }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "experienceSection": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "kind": { "const": "experience" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/experienceItem" }
        }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "projectSection": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "kind": { "const": "project" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/projectItem" }
        }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "publicationSection": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "kind": { "const": "publication" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/publicationItem" }
        }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "achievementSection": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "kind": { "const": "achievement" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/achievementItem" }
        }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "simpleListSection": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/definitions/nodeId" },
        "kind": { "const": "simple_list" },
        "title": { "type": "string" },
        "items": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/definitions/simpleListItem" }
        }
      },
      "required": ["id", "kind", "title", "items"],
      "additionalProperties": false
    },
    "section": {
      "oneOf": [
        { "$ref": "#/definitions/educationSection" },
        { "$ref": "#/definitions/experienceSection" },
        { "$ref": "#/definitions/projectSection" },
        { "$ref": "#/definitions/publicationSection" },
        { "$ref": "#/definitions/achievementSection" },
        { "$ref": "#/definitions/simpleListSection" }
      ]
    }
  }
}
