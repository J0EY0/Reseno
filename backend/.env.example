APP_DATA_DIR=~/.reseno
APP_DB_PATH=~/.reseno/app.db
APP_STORAGE_DIR=~/.reseno/storage
# Optional. Leave blank to use APP_DATA_DIR/user_settings.json.
APP_USER_SETTINGS_PATH=
FRONTEND_RENDER_BASE_URL=http://127.0.0.1:5173
PDF_RENDER_TIMEOUT_MS=30000
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Leave RESENO_MASTER_KEY empty here. The backend fills this once in the real .env.
RESENO_MASTER_KEY=

# Leave RESENO_JWT_SECRET empty here. The backend fills this once in the real .env.
RESENO_JWT_SECRET=
