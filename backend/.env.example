APP_DATA_DIR=~/.reseno
# Optional. Leave blank to use APP_DATA_DIR/app.db and APP_DATA_DIR/storage.
APP_DB_PATH=
APP_STORAGE_DIR=
# Optional. Leave blank to use APP_DATA_DIR/user_settings.json.
APP_USER_SETTINGS_PATH=
# Optional. Serve the production frontend from this directory when configured.
FRONTEND_DIST_DIR=
# Frontend URL reachable by the backend for PDF and image rendering.
FRONTEND_RENDER_BASE_URL=http://127.0.0.1:5173
# Render timeout in milliseconds.
PDF_RENDER_TIMEOUT_MS=30000
# Allowed browser origins for separate frontend hosting. Leave blank for same-origin hosting.
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Blank keys are generated once and saved in .env on first startup.
# WARNING: Do not delete or change these keys after initialization.
# RESENO_MASTER_KEY: losing it prevents decryption of saved credentials.
# RESENO_JWT_SECRET: changing it invalidates login and OAuth sessions.
# Missing keys prevent startup when data already exists.
# Back up this .env together with your database and storage.
RESENO_MASTER_KEY=
RESENO_JWT_SECRET=
