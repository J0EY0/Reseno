APP_ENV=development
APP_DATA_DIR=~/.resumate
APP_DB_PATH=~/.resumate/app.db
APP_STORAGE_DIR=~/.resumate/storage
# Optional. Leave blank to use APP_DATA_DIR/user_settings.json.
APP_USER_SETTINGS_PATH=
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_RENDER_BASE_URL=http://127.0.0.1:5173
PDF_RENDER_TIMEOUT_MS=30000
AUTH_USERNAME=admin
AUTH_PASSWORD=ResuMate@2026
BACKEND_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Leave RESUMATE_MASTER_KEY empty here. The backend fills this once in the real .env.
RESUMATE_MASTER_KEY=

# Leave RESUMATE_JWT_SECRET empty here. The backend fills this once in the real .env.
RESUMATE_JWT_SECRET=
